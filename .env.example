# Kelvin — Example Environment Configuration
# Copy to .env (git-ignored) and adjust. Every value has a safe development default.

# --- Shared ---
KELVIN_ENV=development
KELVIN_LOG_LEVEL=info

# --- apps/api (control plane) ---
KELVIN_API_ADDR=:8080
KELVIN_API_VERSION=1.0.0-alpha
KELVIN_API_BODY_LIMIT_BYTES=1048576

# --- apps/web (dashboard) ---
# Vite dev server; API base for the browser client (relative path proxies to the API).
VITE_API_BASE=/api/v1

# --- apps/worker (scanner daemon) ---
KELVIN_WORKER_ID=worker-local-01
KELVIN_WORKER_POLL_INTERVAL=5s

# --- Future phases (documented here so .env stays stable) ---
# KELVIN_DATABASE_URL=postgres://kelvin:change-me@localhost:5432/kelvin
# KELVIN_REDIS_ADDR=localhost:6379

# ==============================================================================
# Redis 7+ Infrastructure Configuration
# ==============================================================================
REDIS_URL=redis://default:kelvin_redis_dev_secret@localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_TLS_ENABLED=false

# ==============================================================================
# Supabase Infrastructure Configuration (PostgreSQL & Storage)
# ==============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=kelvin_secret_dev_pass
SUPABASE_DB_SSLMODE=verify-full
SUPABASE_DB_MAX_OPEN_CONNS=25
SUPABASE_DB_MAX_IDLE_CONNS=5
SUPABASE_DB_CONN_MAX_LIFETIME=1h
SUPABASE_STORAGE_BUCKET_REPORTS=kelvin-reports-private
SUPABASE_STORAGE_BUCKET_EVIDENCE=kelvin-evidence-private
SUPABASE_STORAGE_SIGNED_URL_EXPIRY=300s

