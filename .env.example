# Kelvin — Local Development Environment Configuration
# Copy this file to .env and adjust if necessary.
#
# References:
#   - ADR-0001: Core Backend Framework & Runtime Environment
#   - ADR-0002: Relational Persistence Layer (PostgreSQL 15+ & golang-migrate)
#   - ADR-0003: Distributed Job Queue & State Broker (Redis 7+ BullMQ pattern)
#   - ADR-0005: Scanner Sandboxing & Mock Target Egress Isolation

# ==============================================================================
# Global & Shared Environment
# ==============================================================================
KELVIN_ENV=development
KELVIN_LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (PostgreSQL 15+ — ADR-0002)
# ==============================================================================
POSTGRES_USER=kelvin
POSTGRES_PASSWORD=kelvin_secret_dev_pass
POSTGRES_DB=kelvin_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
KELVIN_DATABASE_URL=postgres://kelvin:kelvin_secret_dev_pass@localhost:5432/kelvin_dev?sslmode=disable

# ==============================================================================
# Task Broker & Job Queue (Redis 7+ — ADR-0003)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kelvin_redis_dev_secret
KELVIN_REDIS_ADDR=localhost:6379
KELVIN_REDIS_PASSWORD=kelvin_redis_dev_secret

# ==============================================================================
# Object Storage (MinIO S3 Mock Store)
# ==============================================================================
MINIO_ROOT_USER=kelvin_minio_admin
MINIO_ROOT_PASSWORD=kelvin_minio_secret_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_EVIDENCE=kelvin-evidence
MINIO_BUCKET_REPORTS=kelvin-reports
MINIO_USE_SSL=false

# ==============================================================================
# Isolated Mock Vulnerable Target Lab (Safe Scanner Testing)
# ==============================================================================
# Runs on host port 8081 by default so port 8080 remains open for Kelvin API
MOCK_TARGET_PORT=8081
MOCK_TARGET_URL=http://localhost:8081

# ==============================================================================
# apps/api (Control Plane)
# ==============================================================================
KELVIN_API_ADDR=:8080
KELVIN_API_VERSION=1.0.0-alpha
KELVIN_API_BODY_LIMIT_BYTES=1048576

# ==============================================================================
# apps/web (Dashboard Frontend)
# ==============================================================================
VITE_API_BASE=/api/v1

# ==============================================================================
# apps/worker (Scanner Daemon)
# ==============================================================================
KELVIN_WORKER_ID=worker-local-01
KELVIN_WORKER_POLL_INTERVAL=5s
