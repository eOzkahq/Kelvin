# ==============================================================================
# Kelvin Security Scanner Execution Worker Configuration Template
# Target: /etc/kelvin/worker.env
# Permissions: 0600 owned by kelvin-worker:kelvin-worker
#
# DO NOT RUN THE WORKER WITH THIS UNMODIFIED TEMPLATE.
# You must remove KELVIN_CONFIG_STATUS=TEMPLATE_NOT_CONFIGURED and replace
# all placeholder values with verified credentials before deployment.
# ==============================================================================

# Explicit template marker - deployment and startup will fail closed if this is present
KELVIN_CONFIG_STATUS=TEMPLATE_NOT_CONFIGURED

# Core Worker Identity
KELVIN_ENV=staging
KELVIN_WORKER_ID=oracle-arm64-worker-01
KELVIN_WORKER_POLL_INTERVAL=1s
KELVIN_LOG_LEVEL=info

# Upstash Redis Queue (TLS Required in Staging & Production)
# Scheme MUST be rediss:// with verified TLS
KELVIN_REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_TOKEN@REPLACE_WITH_UPSTASH_ENDPOINT.upstash.io:6379
REDIS_TLS_ENABLED=true
KELVIN_WORKER_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_BYTE_HEX_WORKER_TOKEN_SECRET

# Supabase PostgreSQL (Managed DB with SSL verify-full)
KELVIN_DATABASE_URL=postgresql://postgres.REPLACE_WITH_PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
SUPABASE_CA_CERT_PATH=/etc/kelvin/certs/supabase-root-ca.crt
KELVIN_DATABASE_SSL_ROOT_CERT=/etc/kelvin/certs/supabase-root-ca.crt

# Supabase Storage Evidence Upload
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET_EVIDENCE=kelvin-evidence

# OCI Execution & Rootless Podman Configuration (ADR-0008)
KELVIN_OCI_RUNTIME=/usr/bin/podman
KELVIN_SCANNER_NETWORK=kelvin-scanner-net

# Rootless Podman Subordinate UID/GID Configuration (ADR-0008)
# Optional: By default, Kelvin automatically detects and adopts the host's
# provisioned subordinate allocation from /etc/kelvin/subid.env or /etc/subuid
# and /etc/subgid (e.g. 165536 on Oracle Linux 9.8).
# Uncomment only if an explicit non-default override is required:
# KELVIN_SUBUID_START=165536
# KELVIN_SUBGID_START=165536
# KELVIN_SUBID_COUNT=65536

# Egress Proxy Binding
# Binds to the internal gateway IP of the rootless Podman bridge
KELVIN_EGRESS_PROXY_BIND_ADDR=10.89.10.1:0
KELVIN_EGRESS_PROXY_ADVERTISED_HOST=10.89.10.1

# Canary-Only Execution Policy (Restricts execution to controlled mock targets)
KELVIN_CANARY_ONLY=true
KELVIN_CANARY_ALLOWED_TARGETS=scanner-mock.kelvin.internal,mock-target.kelvin.internal,127.0.0.1,localhost

# Cgroups v2 & Sandbox Limits (Conservative bounds for 2 vCPU / 10 GiB RAM host)
KELVIN_LIMITS_CPU_QUOTA=1.0
KELVIN_LIMITS_MEMORY_LIMIT=2048M
KELVIN_LIMITS_MAX_PIDS=64
KELVIN_LIMITS_HARD_EXECUTION_DEADLINE_SECONDS=900
KELVIN_LIMITS_MAX_CONCURRENT_CONNS=10
KELVIN_LIMITS_MAX_REQUESTS_PER_TARGET=5000
