# ==============================================================================
# Kelvin Security Scanner Execution Worker Configuration
# Location: /etc/kelvin/worker.env
# Permissions: 0600 owned by kelvin-worker:kelvin-worker
# ==============================================================================

# Core Worker Identity
KELVIN_ENV=staging
KELVIN_WORKER_ID=oracle-arm64-worker-01
KELVIN_WORKER_POLL_INTERVAL=1s
KELVIN_LOG_LEVEL=info

# Upstash Redis Queue (TLS Required in Staging & Production)
# Scheme MUST be rediss:// with verified TLS
KELVIN_REDIS_URL=rediss://default:your-upstash-redis-token@your-upstash-endpoint.upstash.io:6379
REDIS_TLS_ENABLED=true
KELVIN_WORKER_TOKEN_SECRET=replace-with-at-least-32-byte-hex-encoded-worker-token-secret

# Supabase PostgreSQL (Managed DB with SSL verify-full)
KELVIN_DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
SUPABASE_CA_CERT_PATH=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
KELVIN_DATABASE_SSL_ROOT_CERT=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Supabase Storage Evidence Upload
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET_EVIDENCE=kelvin-evidence

# OCI Execution & Rootless Podman Configuration (ADR-0008)
KELVIN_OCI_RUNTIME=/usr/bin/podman
KELVIN_SCANNER_NETWORK=kelvin-scanner-net

# Egress Proxy Binding
# Binds to the internal gateway IP of the rootless Podman bridge
KELVIN_EGRESS_PROXY_BIND_ADDR=10.89.10.1:0
KELVIN_EGRESS_PROXY_ADVERTISED_HOST=10.89.10.1

# Cgroups v2 & Sandbox Limits
KELVIN_LIMITS_CPU_QUOTA=0.50
KELVIN_LIMITS_MEMORY_LIMIT=2048M
KELVIN_LIMITS_MAX_PIDS=64
KELVIN_LIMITS_HARD_EXECUTION_DEADLINE_SECONDS=900
KELVIN_LIMITS_MAX_CONCURRENT_CONNS=10
KELVIN_LIMITS_MAX_REQUESTS_PER_TARGET=5
