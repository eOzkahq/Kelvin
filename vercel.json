{
  "buildCommand": "npm run build --workspace=@kelvin/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/services/kelvin/__live_probe",
      "destination": "/api/live_probe"
    },
    {
      "source": "/services/kelvin/api/live_probe",
      "destination": "/api/live_probe"
    },
    {
      "source": "/api/live_probe",
      "destination": "/api/live_probe"
    },
    {
      "source": "/services/kelvin/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/services/kelvin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/services/kelvin",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
