{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kelvin:schemas:report.v1.json",
  "title": "Kelvin Customer-Facing Assessment Report v1",
  "description": "Canonical versioned schema for assembled point-in-time security assessment reports, including executive summary, scope, sanitized findings, remediation roadmap, and execution provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "assessment_id",
    "tenant_id",
    "title",
    "generated_at",
    "template_version",
    "summary",
    "scope",
    "execution_status",
    "findings_summary",
    "findings",
    "remediation_guidance",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"]
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "template_version": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_risk_score",
        "posture_band",
        "total_findings",
        "critical_count",
        "high_count",
        "medium_count",
        "low_count",
        "info_count"
      ],
      "properties": {
        "overall_risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "posture_band": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "CLEAN"]
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        },
        "info_count": {
          "type": "integer",
          "minimum": 0
        },
        "executive_narrative": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "scanners",
        "profile"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scanners": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "execution_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "is_partial",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "PARTIAL", "FAILED"]
        },
        "is_partial": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "partial_disclosures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "findings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity_breakdown",
        "priority_breakdown"
      ],
      "properties": {
        "severity_breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "priority_breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "fingerprint",
          "title",
          "severity",
          "status",
          "endpoint"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "format": "uuid"
          },
          "fingerprint": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "cvss_score": {
            "type": ["number", "null"]
          },
          "cwe_id": {
            "type": "string"
          },
          "cve_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "endpoint": {
            "type": "string"
          },
          "risk_score": {
            "type": ["number", "null"]
          },
          "risk_band": {
            "type": "string"
          },
          "sanitized_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "evidence_type",
                "sanitized_content"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "evidence_type": {
                  "type": "string"
                },
                "sanitized_content": {
                  "type": "string"
                },
                "redaction_applied": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "remediation_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "recommended_action"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "target_completion_date": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "template_id",
        "audit_hash",
        "disclaimer"
      ],
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "audit_hash": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    }
  }
}
