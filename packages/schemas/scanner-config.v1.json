{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelvin.security/schema/scanner-config/v1",
  "title": "Kelvin MVP Scanner Configuration v1",
  "description": "Scanner implementation settings are bounded by the selected product scan profile. No CLI arguments, environment variables, targets, arbitrary template paths, or active modes are accepted.",
  "oneOf": [
    {
      "title": "Built-in HTTP preflight",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scanner_id"],
      "properties": {
        "schema_version": { "const": "1.0" }, "scanner_id": { "const": "http_preflight" },
        "execution_mode": { "const": "PASSIVE", "default": "PASSIVE" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 30 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 }
      }
    },
    {
      "title": "Built-in TLS assessor",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scanner_id"],
      "properties": {
        "schema_version": { "const": "1.0" }, "scanner_id": { "const": "tls_assessor" },
        "execution_mode": { "const": "PASSIVE", "default": "PASSIVE" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 60 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 }
      }
    },
    {
      "title": "Built-in security headers and cookies",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scanner_id"],
      "properties": {
        "schema_version": { "const": "1.0" }, "scanner_id": { "const": "http_security_headers" },
        "execution_mode": { "const": "PASSIVE", "default": "PASSIVE" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 60 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 }
      }
    },
    {
      "title": "OWASP ZAP Baseline",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scanner_id"],
      "properties": {
        "schema_version": { "const": "1.0" }, "scanner_id": { "const": "zap" },
        "execution_mode": { "const": "PASSIVE", "default": "PASSIVE" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 600 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
        "zap": {
          "type": "object", "additionalProperties": false,
          "default": { "max_urls": 100, "max_depth": 3 },
          "properties": {
            "max_urls": { "type": "integer", "minimum": 1, "maximum": 250, "default": 100 },
            "max_depth": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 }
          }
        }
      }
    },
    {
      "title": "Nuclei curated safe templates",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scanner_id"],
      "properties": {
        "schema_version": { "const": "1.0" }, "scanner_id": { "const": "nuclei" },
        "execution_mode": { "const": "PASSIVE", "default": "PASSIVE" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 300 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
        "nuclei": {
          "type": "object", "additionalProperties": false,
          "default": { "template_set_id": "kelvin.safe.web.v1", "severity_allowlist": ["info", "low", "medium"] },
          "required": ["template_set_id", "severity_allowlist"],
          "properties": {
            "template_set_id": { "const": "kelvin.safe.web.v1", "default": "kelvin.safe.web.v1" },
            "severity_allowlist": {
              "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "items": { "enum": ["info", "low", "medium", "high", "critical"] },
              "default": ["info", "low", "medium"]
            }
          }
        }
      }
    }
  ]
}
