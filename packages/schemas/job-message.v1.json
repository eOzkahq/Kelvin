{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelvin.security/schemas/job-message.v1.json",
  "title": "Kelvin Assessment Job Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "assessment_id", "tenant_id", "correlation_id", "type", "payload", "max_attempts"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "payload": {"type": "object"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "worker_token": {"type": "string", "minLength": 1}
  }
}
