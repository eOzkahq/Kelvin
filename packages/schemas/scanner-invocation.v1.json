{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelvin.security/schema/scanner-invocation/v1",
  "title": "Kelvin Scanner Invocation Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment", "target", "scope", "profile", "scanner", "execution", "trace"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tenant_id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tenant_id": { "type": "string", "format": "uuid" },
        "authorization_id": { "type": "string", "format": "uuid" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical", "pinned_ips"],
      "properties": {
        "canonical": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "pinned_ips": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "ip" } }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "target"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "target": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "scanner": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "config_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "config_version": { "const": "1.0" },
        "config": { "$ref": "https://kelvin.security/schema/scanner-config/v1" }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_policy_id", "deadline", "timeout_seconds", "requests_per_second", "max_requests_per_target", "max_concurrent_connections", "cpu_quota", "memory_limit", "disk_limit", "max_pids"],
      "properties": {
        "resource_policy_id": { "type": "string", "minLength": 1 },
        "deadline": { "type": "string", "format": "date-time" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "requests_per_second": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_requests_per_target": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_concurrent_connections": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cpu_quota": { "type": "string", "minLength": 1 },
        "memory_limit": { "type": "string", "minLength": 1 },
        "disk_limit": { "type": "string", "minLength": 1 },
        "max_pids": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string" }
      }
    }
  }
}
