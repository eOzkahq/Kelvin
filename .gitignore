# ==============================================================================
# Kelvin Security Platform — Git Ignore Configuration
# Multi-stack rules for Go control plane, React frontend, sandboxed workers & scans
# ==============================================================================

# --- Operating System & Filesystem Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Editor & IDE Directories ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.zed/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
*.bak

# --- Environment Configuration & Secrets (CRITICAL) ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.id_rsa
*.id_ed25519
secrets/
credentials/
config/local.*

# --- Node.js & Web Frontend (apps/web) ---
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Build Caches & Bundles
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.output/
.parcel-cache/
.turbo/
.cache/
*.tsbuildinfo

# --- Go & Native Build Binaries (apps/api, workers) ---
bin/
*.exe
*.dll
*.dylib
*.so
*.out
*.app
target/
# Preserve Go internal packages
!apps/api/pkg/
!pkg/

# --- Python & Testing Utilities ---
__pycache__/
*.py[cod]
.Python
.venv/
venv/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
*.egg-info/

# --- Testing Outputs, Coverage & Observability ---
coverage/
coverage.out
coverage.html
test-results/
.nyc_output/
*.lcov
*.log
logs/

# --- Local Databases, State & Container Volumes ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
postgres-data/
redis-data/
minio-data/
mongo-data/
volumes/
data/
db_data/
docker-compose.override.yml
docker-compose.local.yml
*.local.yml

# --- Security Scanner Outputs, Evidence & Ephemeral Workspaces ---
# Ephemeral assessment execution workspaces (P2-22)
workspaces/
scans/output/
scans/temp/
raw_evidence/
evidence/temp/
reports/temp/
reports/generated/
run-*-artifacts/
*.pcap
*.pcapng
*.har

# Whitelist test fixtures if located under scanner test directories
!tests/fixtures/**
!apps/**/testdata/**

# --- Temporary & Scratch Files ---
tmp/
temp/
scratch/
*.tmp
